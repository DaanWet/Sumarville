# Copy to /etc/sumarville/sumarville.env and make it root-only:
#   sudo install -m 600 -o root -g root sumarville.env.example /etc/sumarville/sumarville.env
# Never commit the real file.

# Bot token from the Discord Developer Portal (Bot -> Reset Token).
BOT_TOKEN=

# Passphrase for the encrypted database. Generate once with: openssl rand -base64 32
# Keep a copy outside this server (password manager): without it the database and its backups are unreadable.
DB_ENCRYPTION_KEY=

# Optional: error reporting to Sentry. Leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Optional, default ./data/sumarville.db (relative to WorkingDirectory).
#DB_PATH=

# Do NOT set these in production:
#   TEST_GUILD_ID, DB_ALLOW_UNENCRYPTED, DB_ALLOW_FRESH_INSTALL
